# رابط الاتصال بـ MongoDB Atlas (من Database > Connect > Drivers)
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/rsvp_db?retryWrites=true&w=majority

# اسم الداتابيز (اختياري - لو مش موجود هيستخدم rsvp_db)
MONGODB_DB=rsvp_db

# كلمة السر اللي هتفتح بيها admin dashboard
ADMIN_PASSWORD=غيّر_دي_لكلمة_سر_قوية
